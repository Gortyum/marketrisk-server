# Copia este archivo a backend/.env para sobrescribir configuración en producción.
#
# Ubicación de la base de datos (SQLite por defecto en backend/market_risk.db).
#COURSE_DATABASE_URL=sqlite:///C:/data/market_risk.db
#
# Orígenes CORS permitidos, separados por coma. Vacío = sin CORS (mismo origen).
# Útil solo si el dashboard se sirve desde otro dominio.
#COURSE_ALLOW_ORIGINS=https://risk.internal.example.com